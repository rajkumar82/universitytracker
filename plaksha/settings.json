      "Rejected": [
        "i (got|was|have been) (rejected|rej)",
        "i did(n't| not) (get|receive) (an? )?(offer|admission)",
        "i (didn't|did not) get (in|into)",
        "(rejected|no offer) (from|by) plaksha",
        "got (rejected|rej) (from|by) plaksha"
      ],
      "Waitlisted": [
        "i (was|got|am) (put on |on the )?wait.?list",
        "i('ve| have) been wait.?listed"
      ]
    }
  }
}
