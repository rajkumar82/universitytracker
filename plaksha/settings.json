    "pillars": {
      "BTech": ["\\bbtech\\b", "b\\.tech", "bachelor of technology", "undergraduate program"],
      "MTech": ["\\bmtech\\b", "m\\.tech", "master of technology", "postgraduate program"],
      "Fellowship": ["\\bfellowship\\b", "plaksha fellowship", "tech leaders fellowship"]
    },
    "scholarships": {
      "Merit": ["merit scholarship", "merit award", "academic scholarship"],
      "Need-based": ["need.?based", "financial aid", "need based scholarship"],
      "Full Scholarship": ["full scholarship", "100% scholarship", "full ride"],
      "Partial Scholarship": ["partial scholarship", "50%", "partial aid"],
      "None": ["no scholarship", "self.?fund", "without scholarship", "paying full"]
    },
    "nationalities": {
      "Indian": ["\\bindian\\b", "india", "\\bdomestic\\b", "nri"],
      "International": ["international", "foreigner", "overseas", "abroad"]
